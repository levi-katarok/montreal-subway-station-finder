# ============================================================================
# MONTREAL TRANSIT EXPLORER - Environment Variables
# ============================================================================
#
# Copy this file to .env and fill in your API keys
#

# Google Maps API Key
# Get your key at: https://console.cloud.google.com/google/maps-apis
# Required APIs:
#   - Maps JavaScript API
#   - Places API
#   - Directions API
#   - Distance Matrix API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# WeatherAPI.com API Key
# Get your free key at: https://www.weatherapi.com/signup.aspx
# Includes weather + air quality data for health-conscious routing
# Example key: 7728de99273a4c0186e151255250511
VITE_WEATHERAPI_KEY=your_weatherapi_key_here

# Optional: Sentry DSN for error tracking
# VITE_SENTRY_DSN=your_sentry_dsn_here

# Optional: Google Analytics ID
# VITE_GA_ID=your_ga_id_here
